SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_EN_APP_PLATFORM
FSCR_DB_SCHEMA=validacion_materiales_tecnicos
SESSION_SECRET=REEMPLAZAR_EN_APP_PLATFORM

# 9100 en local (igual que fscr_proveedores_factura -- coincide con
# apps/web-angular/src/environments/environment.ts). En el servidor Ubuntu
# real (factproveedores) este valor DEBE ser 18082: Apache expone el puerto
# público 8082 con un VirtualHost dedicado (igual patrón que sgi.conf) y le
# hace ProxyPass /api a este puerto interno -- ver deploy.sh y PENDIENTES.md.
FSCR_API_PORT=9100
# false tanto en desarrollo local (`ng serve` en :4200) como en el servidor
# Ubuntu real: en ambos casos otro proceso sirve los estáticos de Angular
# (ng serve en local, Apache2 con DocumentRoot en el servidor -- ver el
# VirtualHost que genera deploy.sh). Solo pasa a `true` en el despliegue
# alternativo vía DigitalOcean App Platform (.do/app.yaml), donde no hay
# Apache y este mismo proceso Node debe servir también el build de Angular.
FSCR_SERVE_STATIC=false
NODE_ENV=development

# Controla si la cookie de sesion se marca Secure/SameSite=None (requiere
# HTTPS real -- si no, el navegador la descarta y todo lo que dependa de la
# sesion responde 401 "sesion no encontrada" aunque el login haya
# funcionado). Deja `false` en local Y en el servidor Ubuntu real (HTTP
# plano via Apache, sin TLS). Solo pon `true` si hay HTTPS de verdad delante
# (dominio con certificado, o DigitalOcean App Platform).
FSCR_COOKIE_SECURE=false

# No solicitado en el spec original de este scaffold, pero necesario en la
# práctica: el frontend Angular (apps/web-angular) llama a esta API con
# `withCredentials` (cookie httpOnly de sesión) desde un ORIGEN distinto
# (dev: http://localhost:4200). Sin una whitelist de CORS explícita la
# cookie de sesión nunca llegaría. Lista separada por comas.
ALLOWED_ORIGINS=http://localhost:4200
